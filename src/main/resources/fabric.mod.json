{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "Polyfrost"
    ],
    "contact": {
        "homepage": "https://polyfrost.org",
        "sources": "https://github.com/Polyfrost/PolyCrosshair"
    },
    "license": "LGPL-3.0-or-later",
    "icon": "assets/polycrosshair/default.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "org.polyfrost.crosshair.PolyCrosshair",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "polycrosshair.mixins.json"
    ],
    "depends": {
        "minecraft": "${minecraft_version_range}",
        "fabricloader": ">=${loader_version}",
        "fabric-language-kotlin": "*",
        "oneconfigv1": ">=${oneconfig_version}"
    }
}
